# ==============================================================================
# CodeVigilant AI Backend Environment Configuration
# ==============================================================================
# Copy this file to .env and customize values for your local environment:
#   cp .env.example .env

# Security / JWT
# Generate a secure 64+ char random hex string (e.g. openssl rand -hex 32)
SECRET_KEY=your_secure_random_jwt_secret_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=codevigilant_db

# Google Gemini API
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Vector Store (ChromaDB)
CHROMA_HOST=localhost
CHROMA_PORT=8000

# CORS Allowed Origins (Comma-separated list or JSON array)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
